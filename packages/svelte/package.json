{
  "name": "@0disoft/banora-svelte",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@0disoft/banora": ">=0.1.0-dev.0 <1",
    "svelte": "5.x"
  },
  "devDependencies": {
    "@0disoft/banora": "workspace:*",
    "svelte": "5.x",
    "typescript": "6.x",
    "@sveltejs/package": "3.x",
    "svelte-check": "4.x"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist --tsconfig tsconfig.json",
    "typecheck": "svelte-check --tsconfig tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0disoft/banora.git",
    "directory": "packages/svelte"
  }
}
