{
  "name": "banora-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/development.ts setup",
    "doctor": "bun scripts/development.ts doctor",
    "commands": "bun scripts/development.ts commands",
    "ops": "bun scripts/operations.ts",
    "release": "bun scripts/release.ts",
    "perf": "bun run build && bun build scripts/performance.ts --target=node --packages=external --outfile .tmp/performance.mjs && node .tmp/performance.mjs",
    "perf:browser": "bun run build:examples && bun scripts/browser-smoke.ts --performance-only",
    "clean": "bun scripts/development.ts clean",
    "boundaries": "bun scripts/repository-policy.ts",
    "ci:plan": "bun scripts/ci.ts plan",
    "ci:run": "bun scripts/ci.ts run",
    "security:files": "bun scripts/security.ts",
    "security:deps": "bun audit --audit-level=high",
    "build": "vite build --config packages/sdk/vite.config.ts && tsc -p packages/sdk/tsconfig.build.json && bun scripts/build-browser.ts",
    "build:adapters": "bun run build && bun scripts/build-adapters.ts",
    "build:cli": "bun run build && bun scripts/build-cli.ts",
    "cli": "node packages/cli/dist/main.js",
    "smoke:cli": "bun run build:cli && bun scripts/packed-cli.ts",
    "build:examples": "bun run build:adapters && vite build --config examples/vite.config.ts",
    "dev": "bun run build:adapters && vite --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt . --check",
    "format:write": "oxfmt .",
    "test": "bun test packages scripts/*.test.ts",
    "migration-check": "bun run build && bun test packages/sdk/test/checkpoint.test.ts scripts/preferences.test.ts scripts/draft-store.test.ts scripts/operations.test.ts",
    "docs": "bun scripts/check-docs.ts",
    "smoke": "bun run build && bun scripts/packed-consumer.ts",
    "smoke:adapters": "bun run build:adapters && bun scripts/packed-adapters.ts",
    "smoke:starter": "bun run build && bun scripts/packed-starter.ts --browser",
    "example:katago": "bun run build && bun examples/katago-cli/main.ts",
    "smoke:katago": "bun run build && bun scripts/live-katago.ts",
    "smoke:katago:node": "bun run build && bun build scripts/live-katago.ts --target=node --packages=external --outfile .tmp/live-katago-runner.mjs && node .tmp/live-katago-runner.mjs",
    "smoke:browser": "bun run build:examples && bun scripts/browser-smoke.ts",
    "browser:install": "bun run playwright-cli install-browser",
    "typecheck:svelte": "bun run --cwd packages/svelte typecheck",
    "check": "bun run lint && bun run format && bun run boundaries && bun run build:adapters && bun scripts/build-cli.ts && bun run typecheck && bun run typecheck:svelte && bun run test && bun run docs && bun scripts/packed-consumer.ts && bun scripts/packed-cli.ts"
  },
  "devDependencies": {
    "@0disoft/banora": "workspace:*",
    "@0disoft/banora-react": "workspace:*",
    "@0disoft/banora-svelte": "workspace:*",
    "@0disoft/banora-vue": "workspace:*",
    "@fontsource-variable/noto-sans": "5.x",
    "@fontsource-variable/noto-sans-devanagari": "5.x",
    "@fontsource-variable/noto-sans-jp": "5.x",
    "@fontsource-variable/noto-sans-kr": "5.x",
    "@fontsource-variable/noto-sans-sc": "5.x",
    "@fontsource-variable/noto-sans-thai": "5.x",
    "@fontsource/be-vietnam-pro": "5.x",
    "@fontsource/pt-sans": "5.x",
    "@phosphor-icons/core": "2.x",
    "@playwright/cli": "0.x",
    "@sveltejs/vite-plugin-svelte": "7.x",
    "@types/bun": "1.x",
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "oxfmt": "0.x",
    "oxlint": "1.x",
    "react": "19.x",
    "react-dom": "19.x",
    "svelte": "5.x",
    "typescript": "7.x",
    "vite": "8.x",
    "vue": "3.x"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
