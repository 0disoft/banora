{
  "name": "banora-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "vite build --config packages/sdk/vite.config.ts && tsc -p packages/sdk/tsconfig.build.json && bun scripts/build-browser.ts",
    "build:adapters": "bun run build && bun scripts/build-adapters.ts",
    "build:examples": "bun run build:adapters && vite build --config examples/vite.config.ts",
    "dev": "bun run build:adapters && vite --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages scripts/scenario-result.test.ts",
    "docs": "bun scripts/check-docs.ts",
    "smoke": "bun run build && bun scripts/packed-consumer.ts",
    "smoke:adapters": "bun run build:adapters && bun scripts/packed-adapters.ts",
    "smoke:browser": "bun run build:examples && bun scripts/browser-smoke.ts",
    "typecheck:svelte": "bun run --cwd packages/svelte typecheck",
    "check": "bun run build:adapters && bun run typecheck && bun run typecheck:svelte && bun run test && bun run docs && bun scripts/packed-consumer.ts"
  },
  "devDependencies": {
    "@banora/sdk": "workspace:*",
    "@banora/react": "workspace:*",
    "@banora/vue": "workspace:*",
    "@banora/svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.x",
    "react": "19.x",
    "react-dom": "19.x",
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "vue": "3.x",
    "svelte": "5.x",
    "@playwright/cli": "0.x",
    "@types/bun": "1.x",
    "typescript": "7.x",
    "vite": "8.x"
  },
  "engines": {"node": ">=24 <25"}
}
